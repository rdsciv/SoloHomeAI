{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/app", "destination": "/#/app", "permanent": false },
    { "source": "/app/", "destination": "/#/app", "permanent": false },
    { "source": "/dashboard", "destination": "/#/app", "permanent": false },
    { "source": "/dashboard/", "destination": "/#/app", "permanent": false },
    { "source": "/system-map", "destination": "/#/system-map", "permanent": false },
    { "source": "/system-map/", "destination": "/#/system-map", "permanent": false },
    { "source": "/solohome-dashboard.html", "destination": "/#/app", "permanent": false },
    { "source": "/solohome-system-map.html", "destination": "/#/system-map", "permanent": false },
    { "source": "/solohome-landing.html", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
